// In development a personal key can be set in .env (GOOGLE_MAPS_KEY_DEV),
// because the production key only allows the live site's domain.
// .env is loaded in .eleventy.js, as this file is also bundled for the browser
const useDevMapsKey =
  process.env.ENV === "development" && typeof process !== "undefined" && process.env.GOOGLE_MAPS_KEY_DEV

module.exports = {
  ENV: process.env.ENV,
  GOOGLE_MAPS_KEY: useDevMapsKey ? process.env.GOOGLE_MAPS_KEY_DEV : "",
  GOOGLE_MAPS_ID: useDevMapsKey ? process.env.GOOGLE_MAPS_ID_DEV || "DEMO_MAP_ID" : "",
  SITE: "https://example.com",
  SITE_DEV: "https://example.com",
  // In development, API calls go to the local dev server, which proxies them
  // to DEV_API_PROXY_TARGET (see .eleventy.js) to avoid CORS on localhost
  BACKEND: process.env.ENV === "development" ? "" : "https://api.example.com",
  BACKEND_DEV: process.env.ENV === "development" ? "" : "https://testapi.example.com",
  DEV_API_PROXY_TARGET: "https://testapi.example.com",
  PHOTO_SOURCE: "https://example.cloudfront.net",
  PHOTO_BUCKET: "example",
  THUMBNAILS_QUERY_LIMIT: 40,
  BREAKPOINT_PHONE_XS: 360,
  BREAKPOINT_PHONE_SM: 480,
  BREAKPOINT_PHONE: 640,
  BREAKPOINT_TABLET: 768,
  BREAKPOINT_DESKTOP: 1024,
  BREAKPOINT_DESKTOP_LG: 1220,
  CAROUSEL_SLIDESHOW_DELAY: 4000,
  DEFAULT_THEME: "light",
  LOCALES: [
    { code: "en", text: "English" },
    { code: "hu", text: "Magyar" },
    { code: "it", text: "Italian" },
    { code: "pl", text: "Polska" },
    { code: "fr", text: "Français" },
  ],
  AGE_RESTRICTION_TAG: "18+",
}
